# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Mobile PDF Optimization (Optional)
# Set to 'true' to enable automatic serving of mobile-optimized PDF variants
# Mobile variants should be named: filename_mobile_flat.pdf
# See MOBILE_PDF_GUIDE.md for details
ENABLE_MOBILE_PDF_VARIANT=false

# Object Storage
REPL_OBJSTORE_BUCKET_ID=your_bucket_id

# Inquiry and order emails use the connected Resend integration.
# Verify the sender domain in Resend and connect it in Replit.
INQUIRY_FROM_EMAIL="D.EF Studio <inquiries@example.com>"

# Accounts: supply DATABASE_URL and a random SESSION_SECRET (32+ characters)
# using workspace Secrets, never actual values in this file.
# Optional comma-separated exact trusted origins (HTTPS in production).
# The canonical site and Replit-provided hosts are already trusted.
AUTH_TRUSTED_ORIGINS=
